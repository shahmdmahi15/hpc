generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  HANDLER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  USER_CREATE
  USER_UPDATE
  USER_PASSWORD_RESET
  USER_DELETE
  USER_SESSIONS_REVOKED
  PROFILE_UPDATE
  PASSWORD_UPDATE
  PATIENT_CREATE
  PATIENT_UPDATE
  PATIENT_DELETE
  FILE_CREATE
  FILE_UPDATE
  TREATMENT_SLOT_CREATE
  TREATMENT_SLOT_UPDATE
  PAYMENT_CREATE
  ROOM_CREATE
  ROOM_UPDATE
  ROOM_DELETE
  ROOM_OCCUPY
  ROOM_RELEASE
  SLOT_CREATE
  SLOT_UPDATE
  SLOT_DELETE
  SERIAL_CREATE
  SERIAL_UPDATE
  SERIAL_STATUS_CHANGE
  SERIAL_CANCEL
  ASSESSMENT_CREATE
  ASSESSMENT_UPDATE
  TREATMENT_SESSION_CREATE
  BILLING_CREATE
  BILLING_AUDIT
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum SerialStatus {
  PENDING
  CHECKED_IN
  WAITING
  CALLING
  IN_CONSULTATION
  IN_THERAPY
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisitType {
  NEW_CONSULTATION
  FOLLOW_UP
  REPORT_REVIEW
  THERAPY_PROCEDURE
  EMERGENCY
}

enum Priority {
  REGULAR
  URGENT
  EMERGENCY
  VIP
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  INSURANCE
  OTHER
}

enum HourlySlot {
  SLOT_10_11 // 10:00 - 11:00 AM
  SLOT_11_12 // 11:00 - 12:00 PM
  SLOT_12_01 // 12:00 - 01:00 PM
  SLOT_01_02 // 01:00 - 02:00 PM
  SLOT_02_03 // 02:00 - 03:00 PM
  SLOT_03_04 // 03:00 - 04:00 PM
  SLOT_04_05 // 04:00 - 05:00 PM
  SLOT_05_06 // 05:00 - 06:00 PM
  SLOT_06_07 // 06:00 - 07:00 PM
  SLOT_07_08 // 07:00 - 08:00 PM
  CUSTOM
}

enum PainSide {
  RIGHT
  LEFT
  BOTH
}

enum PainType {
  SHARP
  DULL
  BURNING
  RADIATING
}

enum RomStatus {
  NORMAL
  RESTRICTED
}

enum PackageStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum PunctualityStatus {
  ON_TIME
  MODERATE_LATE
  SEVERE_LATE
}

// --------------------------------------------------------
// USER & AUTHENTICATION
// --------------------------------------------------------

model User {
  id       String @id @default(cuid())
  name     String
  role     Role
  password String

  // Relations
  sessions           Session[]
  auditLogs          AuditLog[]
  registeredPatients Patient[]            @relation("PatientRegistrar")
  doctorSerials      Serial[]             @relation("DoctorSerials")
  handlerSerials     Serial[]             @relation("HandlerSerials")
  createdSerials     Serial[]             @relation("CreatedSerials")
  doctorAssessments  ClinicalAssessment[] @relation("DoctorAssessments")
  conductedSessions  TreatmentSession[]   @relation("HandlerSessions")
  cashierBillings    BillingRecord[]      @relation("CashierBillings")
  auditedBillings    BillingRecord[]      @relation("AuditedBillings")

  // Room Relations
  doctorRooms        Room[]               @relation("RoomCurrentDoctor")
  handlerRooms       Room[]               @relation("RoomCurrentHandler")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id    String @id @default(cuid())
  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress    String?
  userAgent    String?
  device       String?
  browser      String?
  os           String?

  expiresAt    DateTime
  revokedAt    DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  status    AuditStatus @default(SUCCESS)

  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?

  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// --------------------------------------------------------
// PATIENT MASTER MODEL
// --------------------------------------------------------

model Patient {
  id                       String      @id @default(cuid())
  patientId                String      @unique // e.g. "1800", "1806", "HPC-1800" (4-digit ID prominently used on physical cards)
  nationalId               String?     // NID / Passport / Identification
  name                     String      // Bengali / English name (e.g. উম্মে হাবিবা, আব্দুল খালেক)
  phone                    String      // Full phone (e.g. 01973-818213)
  email                    String?
  dateOfBirth              DateTime?
  age                      Int?        // Recorded directly e.g. 22
  gender                   Gender      @default(MALE) // Crucial for male/female room and therapy segregation
  bloodGroup               BloodGroup?
  occupation               String?
  address                  String?     // Location e.g. মোস্তফাপুর, সুইটি, ঝিনাইদহ, নড়াইল
  city                     String?

  // Emergency Contact Details
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Medical Profile & Baseline Notes
  primaryCondition         String?     // Primary diagnosis / complaint (e.g. Lumbar Spondylosis)
  allergies                String?
  medicalHistory           String?     // Past surgeries, hypertension, diabetes
  currentMedications       String?
  notes                    String?     // General front-desk or doctor remarks

  isActive                 Boolean     @default(true)

  registeredById           String?
  registeredBy             User?       @relation("PatientRegistrar", fields: [registeredById], references: [id], onDelete: SetNull)

  // Relations
  serials                  Serial[]
  assessments              ClinicalAssessment[]
  treatmentSessions        TreatmentSession[]
  packages                 PatientPackage[]
  billingRecords           BillingRecord[]
  occupiedRooms            Room[]               @relation("RoomCurrentPatient")

  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@index([phone])
  @@index([name])
  @@index([patientId])
  @@index([gender])
  @@index([registeredById])
  @@index([createdAt])
}

// --------------------------------------------------------
// SERIAL / QUEUE TOKEN (Daily Desk & Hourly Slot Register)
// --------------------------------------------------------

model Serial {
  id                 String        @id @default(cuid())
  serialNumber       Int           // Daily sequential token (1, 2, 3... 50) per date
  serialCode         String?       @unique // Human code e.g. "APT-301" or "SER-20260826-01"

  date               DateTime      // Appointment / Queue date
  timeSlot           String?       // Display time e.g. "01:00 - 02:00 PM" or "1.00"
  hourlySlot         HourlySlot    @default(CUSTOM) // Hourly bucket (10-11, 1-2, etc.)
  gender             Gender        @default(MALE) // Gender track for chamber & bay allocation

  status             SerialStatus  @default(PENDING)
  type               VisitType     @default(NEW_CONSULTATION)
  priority           Priority      @default(REGULAR)

  // Logistics & Room Timing (Matching Care Handler Timing Log)
  roomNo                 String?           // Room / Bay (e.g. "Chamber 1", "Rehab Studio 2", "Physio Bay 4")
  toldTime               DateTime?         // Promised arrival time told by receptionist on phone
  scheduledTime          DateTime?         // SD Time (Scheduled Desired Time)
  inTime                 DateTime?         // In Time (Actual patient physical arrival/check-in)
  latenessMinutes        Int               @default(0) // Lateness in minutes from toldTime
  punctualityStatus      PunctualityStatus @default(ON_TIME) // ON_TIME, MODERATE_LATE, SEVERE_LATE
  queuePriorityScore     Int               @default(0) // 0 for on-time/normal, +5 penalty offset if >30m late
  therapyStartTime       DateTime?         // T Time (Therapy execution start)
  outTime                DateTime?         // O Time (Completion / Departure)
  restTime               DateTime?         // R Time (Post-therapy recovery)
  assignedTreatmentPlan  String?           // Doctor's prescribed modalities when routing to Handler

  // Desk Flags
  isReport           Boolean       @default(false) // e.g. "রবিন - রিপোর্ট"
  notes              String?       // Desk note / location remark (e.g. "মোস্তফাপুর")

  // Day Cash Ledger Entry
  fee                Float         @default(0.0)
  paidAmount         Float         @default(0.0)
  refundedAmount     Float         @default(0.0)
  discountAmount     Float         @default(0.0)
  isPackageCovered   Boolean       @default(false) // Marked as N.P (No Payment / Package covered)
  packageId          String?
  package            PatientPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  paymentStatus      PaymentStatus @default(UNPAID)
  paymentMethod      PaymentMethod?

  // Relations
  patientId          String
  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId           String?
  doctor             User?         @relation("DoctorSerials", fields: [doctorId], references: [id], onDelete: SetNull)

  handlerId          String?
  handler            User?         @relation("HandlerSerials", fields: [handlerId], references: [id], onDelete: SetNull)

  createdById        String?
  createdBy          User?         @relation("CreatedSerials", fields: [createdById], references: [id], onDelete: SetNull)

  billingRecords     BillingRecord[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([date, serialNumber])
  @@index([patientId])
  @@index([packageId])
  @@index([doctorId])
  @@index([handlerId])
  @@index([date])
  @@index([hourlySlot])
  @@index([status])
  @@index([paymentStatus])
  @@index([gender])
  @@index([createdAt])
}

// --------------------------------------------------------
// CLINICAL PHYSIOTHERAPY ASSESSMENT (From HPC Assessment Form)
// --------------------------------------------------------

model ClinicalAssessment {
  id                   String     @id @default(cuid())
  date                 DateTime   @default(now())

  // Patient Link
  patientId            String
  patient              Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId             String?
  doctor               User?      @relation("DoctorAssessments", fields: [doctorId], references: [id], onDelete: SetNull)

  // ## 2 Pain Details
  painArea             String?    // e.g. "Neck", "Shoulder", "Back", "Knee", "Heel", "Others"
  side                 PainSide?  @default(BOTH) // Right, Left, Both
  duration             String?    // Duration of symptoms
  painType             PainType?  @default(DULL) // Sharp, Dull, Burning, Radiating

  // ## 3 Pain Scale (VAS 0-10)
  vasScore             Int?       // Baseline VAS score (0 to 10)
  painIncreasesWith    String?    // "Movement", "Sitting", "Standing", "Walking"
  painReducesWith      String?    // "Rest", "Medicine", "Heat"

  // ## 4 History
  hasInjury            Boolean    @default(false) // Injury / Accident
  hasSurgery           Boolean    @default(false) // Surgery History
  postureAdviceGiven   Boolean    @default(false) // Posture advice given
  previousTreatment    String?    // "Medicine", "Physiotherapy"

  // ## 5 Functional Limitation / Difficulty In
  difficultyIn         String?    // "Bending", "Sitting", "Standing", "Walking", "Lifting"

  // ## 6 Physical Examination
  rom                  RomStatus  @default(NORMAL) // Normal / Restricted
  hasMuscleSpasm       Boolean    @default(false)
  hasTenderness        Boolean    @default(false)
  hasSwelling          Boolean    @default(false)

  // ## 7 Physiotherapy Diagnosis
  diagnosis            String?

  // ## 8 Treatment Plan (Prescribed Modalities)
  prescribedModalities String?    // "Hot pack", "IFT/TENS", "Ultrasound (UST)", "SWD", "PMF", "Stretching", "Strengthening", "Posture correction"

  // ## 9 Home Advice & Follow-up
  exerciseExplained    Boolean    @default(true)
  homePostureAdvice    Boolean    @default(true)
  postTreatmentVas     Int?       // VAS Pain score after treatment (0-10)
  improvement          String?    // Improvement assessment note
  clinicalNotes        String?

  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
}

// --------------------------------------------------------
// MULTI-SESSION TREATMENT LOG (From HPC Clinical Session Sheet)
// --------------------------------------------------------

model TreatmentSession {
  id                 String   @id @default(cuid())
  date               DateTime @default(now())
  sessionNumber      Int?     // Session / Day sequence (e.g. Day 1, Day 2...)

  // Patient Link
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Assigned Care Handler / Therapist
  handlerId          String?
  handler            User?    @relation("HandlerSessions", fields: [handlerId], references: [id], onDelete: SetNull)

  // Clinical Vitals & Modalities Delivered
  bloodPressure      String?  // BP (e.g. "120/80")
  complaint          String?  // Patient's complaint that day
  treatmentPlan      String?  // Plan for the day (e.g. "IFT (20), UST (10), SWD (20)")
  treatmentPerformed String   // Modalities executed (e.g. "D-N, UST, SWD, T-40, TENS, IFT, mass, PMF, Nemas, Lazas")
  notes              String?

  // Payment & Billing for Treatment Session
  fee                Float         @default(0.0)
  paidAmount         Float         @default(0.0)
  refundedAmount     Float         @default(0.0)
  discountAmount     Float         @default(0.0)
  isPackageCovered   Boolean       @default(false)
  packageId          String?
  package            PatientPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  paymentStatus      PaymentStatus @default(UNPAID)
  paymentMethod      PaymentMethod?

  billingRecords     BillingRecord[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([patientId])
  @@index([packageId])
  @@index([paymentStatus])
  @@index([handlerId])
  @@index([date])
}

// --------------------------------------------------------
// PATIENT REHABILITATION PACKAGE (From HPC Package Ledger)
// --------------------------------------------------------

model PatientPackage {
  id             String         @id @default(cuid())
  packageName    String         // e.g. "21-30 Days Pain Care Rehabilitation Package"
  totalDays      Int            @default(30) // 21 - 30 days
  totalAmount    Float          // Package price (e.g. 10000, 13000, 20000)
  paidAmount     Float          @default(0.0)
  refundedAmount Float          @default(0.0)
  dueAmount      Float          @default(0.0)
  startDate      DateTime       @default(now())
  endDate        DateTime?
  status         PackageStatus  @default(ACTIVE)
  notes          String?

  // Relations
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  serials        Serial[]
  treatmentSessions TreatmentSession[]
  billingRecords BillingRecord[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([patientId])
  @@index([status])
}

// --------------------------------------------------------
// BILLING & CASH LEDGER (From Daily Cash Ledger & Card)
// --------------------------------------------------------

model BillingRecord {
  id               String         @id @default(cuid())
  date             DateTime       @default(now())
  dayNumber        Int?           // Day 1, 2, 3... of session

  // Financial Figures
  actualBill       Float          @default(0.0) // A Bill (e.g. 2,000 / 500)
  paidAmount       Float          @default(0.0) // Pay. Bill (or 0 if N.P)
  refundedAmount   Float          @default(0.0) // Refunded amount back to patient
  advanceAmount    Float          @default(0.0) // Advance deposit or discount
  dueAmount        Float          @default(0.0) // Remaining due balance
  isPackageCovered Boolean        @default(false) // Flag for N.P (Package covered session)

  paymentStatus    PaymentStatus  @default(PAID)
  paymentMethod    PaymentMethod? @default(CASH)

  // Patient Link
  patientId        String
  patient          Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Package Link (Optional)
  packageId        String?
  package          PatientPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  // Serial Link (Optional)
  serialId         String?
  serial           Serial?        @relation(fields: [serialId], references: [id], onDelete: SetNull)

  // Treatment Session Link (Optional)
  treatmentSessionId String?
  treatmentSession   TreatmentSession? @relation(fields: [treatmentSessionId], references: [id], onDelete: SetNull)

  // Sign-off Roles (Cashier & CEO Audit)
  cashierId        String?
  cashier          User?          @relation("CashierBillings", fields: [cashierId], references: [id], onDelete: SetNull)

  auditedById      String?
  auditedBy        User?          @relation("AuditedBillings", fields: [auditedById], references: [id], onDelete: SetNull)

  notes            String?        // Remarks e.g. "N.P", "Cash deposit", "Refund: ₹500 returned"

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([patientId])
  @@index([packageId])
  @@index([serialId])
  @@index([treatmentSessionId])
  @@index([paymentStatus])
  @@index([cashierId])
  @@index([auditedById])
  @@index([date])
}

// --------------------------------------------------------
// DYNAMIC CLINIC ROOMS & REALTIME MULTI-BED OCCUPANCY
// --------------------------------------------------------

model Room {
  id                      String    @id @default(cuid())
  roomNumber              String    @unique // e.g. "201", "207", "305", "VIP-1"
  name                    String    // e.g. "Doctor Consultation Chamber 1", "Male Electrotherapy Bay 5"
  purpose                 String    @default("Physiotherapy & Modalities") // e.g. "Consultation", "Male Bay", "Female Bay", "Active Rehab", "Spinal Traction"
  type                    String    @default("THERAPY_BAY") // "CONSULTATION", "THERAPY_BAY", "REHAB_STUDIO", "FEMALE_BAY", "MALE_BAY", "PROCEDURE"
  capacity                Int       @default(2) // Total treatment beds / stations in this room
  genderPreference        String    @default("ALL") // "MALE", "FEMALE", "ALL"
  floor                   String    @default("2nd Floor")
  isActive                Boolean   @default(true)
  isStaffOnly             Boolean   @default(false)
  sortOrder               Int       @default(0)
  
  isOccupied              Boolean   @default(false)
  currentPatientId        String?
  currentPatient          Patient?  @relation("RoomCurrentPatient", fields: [currentPatientId], references: [id], onDelete: SetNull)

  currentDoctorId         String?
  currentDoctor           User?     @relation("RoomCurrentDoctor", fields: [currentDoctorId], references: [id], onDelete: SetNull)

  currentHandlerId        String?
  currentHandler          User?     @relation("RoomCurrentHandler", fields: [currentHandlerId], references: [id], onDelete: SetNull)

  currentSlotId           String?
  occupiedSince           DateTime?
  expectedDurationMinutes Int?      @default(45)

  notes                   String?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([roomNumber])
  @@index([isActive])
  @@index([isStaffOnly])
  @@index([isOccupied])
  @@index([currentPatientId])
  @@index([currentDoctorId])
  @@index([currentHandlerId])
}

// --------------------------------------------------------
// DYNAMIC SERIAL BOOKING SLOTS & CAPACITY CONFIGURATION
// --------------------------------------------------------

model BookingSlot {
  id              String    @id @default(cuid())
  slotCode        String    @unique // e.g. "SLOT_10_11", "SLOT_11_12", "SLOT_07_08"
  startTime       String    // e.g. "10:00 AM"
  endTime         String    // e.g. "11:00 AM"
  label           String    // e.g. "10:00 AM - 11:00 AM"
  maxCapacity     Int       @default(6) // Admin-configurable maximum patients per slot
  intervalMinutes Int       @default(10) // e.g. 10 minutes per ticket/token
  isActive        Boolean   @default(true) // Enable/disable slot
  isVipOnly       Boolean   @default(false)
  sortOrder       Int       @default(0)
  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slotCode])
  @@index([isActive])
  @@index([sortOrder])
}



