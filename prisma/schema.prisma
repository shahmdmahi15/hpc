generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  HANDLER
  CASHIER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  USER_CREATE
  USER_UPDATE
  USER_PASSWORD_RESET
  USER_DELETE
  USER_SESSIONS_REVOKED
  SESSION_REVOKE
  PERFORMER_CREATE
  PERFORMER_DELETE
  ROOM_CREATE
  ROOM_UPDATE
  ROOM_STATUS_CHANGE
  ROOM_DELETE
  PROFILE_UPDATE
  PASSWORD_UPDATE
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum RoomAccessType {
  PUBLIC
  STAFF
  DOCTOR
}

enum RoomGender {
  MALE
  FEMALE
  COMMON
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

// --------------------------------------------------------
// USER & AUTHENTICATION
// --------------------------------------------------------

model User {
  id       String @id @default(cuid())
  role     Role   @unique
  password String

  sessions   Session[]
  auditLogs  AuditLog[]
  performers Performer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id    String @id @default(cuid())
  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?
  device    String?
  browser   String?
  os        String?

  expiresAt    DateTime
  revokedAt    DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction
  status AuditStatus @default(SUCCESS)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  performerId String?
  performer   Performer? @relation(fields: [performerId], references: [id], onDelete: SetNull)

  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([performerId])
  @@index([action])
  @@index([status])
  @@index([entity])
  @@index([createdAt])
}

model Performer {
  id    String @id @default(cuid())
  name  String
  phone String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([phone])
}

model Room {
  id         String         @id @default(cuid())
  number     String         @unique
  purpose    String
  accessType RoomAccessType
  gender     RoomGender
  status     RoomStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([number])
}
