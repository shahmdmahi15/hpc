generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  HANDLER
  CASHIER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  USER_CREATE
  USER_UPDATE
  USER_PASSWORD_RESET
  USER_DELETE
  USER_SESSIONS_REVOKED
  PROFILE_UPDATE
  PASSWORD_UPDATE
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

// --------------------------------------------------------
// USER & AUTHENTICATION
// --------------------------------------------------------

model User {
  id       String @id @default(cuid())
  role     Role   @unique
  password String

  // Relations
  sessions  Session[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id    String @id @default(cuid())
  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress    String?
  userAgent    String?
  device       String?
  browser      String?
  os           String?

  expiresAt    DateTime
  revokedAt    DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  status    AuditStatus @default(SUCCESS)

  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?

  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
