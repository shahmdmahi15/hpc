generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  HANDLER
  CASHIER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  USER_CREATE
  USER_UPDATE
  USER_PASSWORD_RESET
  USER_DELETE
  USER_SESSIONS_REVOKED
  SESSION_REVOKE
  PERFORMER_CREATE
  PERFORMER_UPDATE
  PERFORMER_DELETE
  ROOM_CREATE
  ROOM_UPDATE
  ROOM_STATUS_CHANGE
  ROOM_DELETE
  ROOM_SEED
  PROFILE_UPDATE
  PASSWORD_UPDATE

  // Therapy Slot Management Audits
  THERAPY_SLOT_CREATE
  THERAPY_SLOT_UPDATE
  THERAPY_SLOT_STATUS_CHANGE
  THERAPY_SLOT_DELETE
  THERAPY_SLOT_SEED

  // Patient Audits
  PATIENT_CREATE
  PATIENT_UPDATE

  // Appointment Audits
  APPOINTMENT_CREATE
  APPOINTMENT_UPDATE
  APPOINTMENT_CANCEL
  EXTRA_APPOINTMENT_APPROVE
  EXTRA_APPOINTMENT_REJECT

  // Treatment Plan Audits
  TREATMENT_PLAN_CREATE
  TREATMENT_PLAN_UPDATE
  TREATMENT_PLAN_DELETE
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum RoomAccessType {
  PUBLIC
  PRIVATE
  DOCTOR
  STAFF
  THERAPY
  CASHIER
}

enum RoomGender {
  MALE
  FEMALE
  COMMON
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum Gender {
  MALE
  FEMALE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
  ALL
}

enum SlotStatus {
  OPEN
  FULL
  BLOCKED
  CANCELLED
}

enum AppointmentType {
  THERAPY
  CONSULTATION
}

enum QueueType {
  THERAPY
  CONSULTATION
}

enum BookingType {
  REGULAR
  EXTRA
}

enum ExtraApprovalStatus {
  NOT_APPLICABLE
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CALLING
  IN_CONSULTATION
  IN_THERAPY
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ClinicalOptionCategory {
  PAIN_AREA
  TREATMENT_PLAN
  PAIN_TYPE
  AGGRAVATING_FACTOR
  RELIEVING_FACTOR
  FUNCTIONAL_LIMITATION
}

// --------------------------------------------------------
// USER & AUTHENTICATION (RBAC)
// --------------------------------------------------------

model User {
  id       String  @id @default(cuid())
  role     Role
  password String
  name     String?
  email    String?
  whatsapp String?
  consultationFee Float? @default(0)
  consultationRoomId String?
  consultationRoom   Room?   @relation("DoctorConsultationRoom", fields: [consultationRoomId], references: [id], onDelete: SetNull)

  sessions   Session[]
  auditLogs  AuditLog[]
  performers Performer[]

  // Doctor & Approver clinical relations
  doctorAppointments        Appointment[]   @relation("DoctorAppointments")
  approvedAppointmentExtras Appointment[]   @relation("AppointmentExtraApprover")
  medicalRecords            MedicalRecord[]
  treatmentPlans            TreatmentPlan[]
  consultationSerials       ConsultationSerial[] @relation("DoctorConsultationSerials")
  prescriptions             Prescription[]       @relation("DoctorPrescriptions")
  sentChatMessages          ChatMessage[]        @relation("SentChatMessages")
  receivedChatMessages      ChatMessage[]        @relation("ReceivedChatMessages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([email])
  @@index([whatsapp])
  @@index([consultationRoomId])
}

model Session {
  id    String @id @default(cuid())
  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?
  device    String?
  browser   String?
  os        String?

  expiresAt    DateTime
  revokedAt    DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction
  status AuditStatus @default(SUCCESS)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  performerId String?
  performer   Performer? @relation(fields: [performerId], references: [id], onDelete: SetNull)

  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([performerId])
  @@index([action])
  @@index([status])
  @@index([entity])
  @@index([createdAt])
}

// --------------------------------------------------------
// PERFORMER (PERSON IDENTITY FOR DESKS: RECEPTIONIST, HANDLER, CASHIER)
// --------------------------------------------------------

model Performer {
  id       String  @id @default(cuid())
  name     String
  email    String?
  whatsapp String
  phone    String  @default("") // Compatibility fallback matching whatsapp
  pin      String  // 4-digit security PIN

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]

  // Desk operations
  conductedAppointments Appointment[] @relation("PerformerAppointments")
  bookedAppointments    Appointment[] @relation("AppointmentBooker")
  chatMessages          ChatMessage[] @relation("PerformerChatMessages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([whatsapp])
  @@index([phone])
}

model Room {
  id         String         @id @default(cuid())
  number     String         @unique
  purpose    String
  accessType RoomAccessType
  gender     RoomGender
  status     RoomStatus

  therapySlots TherapySlot[]
  appointments Appointment[]
  consultingDoctors User[] @relation("DoctorConsultationRoom")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([number])
}

// --------------------------------------------------------
// THERAPY SLOTS (PREDEFINED MASTER SLOTS)
// --------------------------------------------------------

model TherapySlot {
  id String @id @default(cuid())

  label     String   // e.g. "10:00 AM - 11:00 AM"
  startTime String   // "10:00"
  endTime   String   // "11:00"
  order     Int      @default(0)

  status   SlotStatus @default(OPEN)
  isActive Boolean    @default(true)

  // Operating days of the week ("ALL" or comma-separated "SATURDAY,SUNDAY,...")
  weekDays String @default("ALL")

  // Therapy room assignment (optional)
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  // Predefined session quotas used daily by patient ticket booking
  regularMaleCapacity   Int @default(3)
  regularFemaleCapacity Int @default(3)
  extraMaleCapacity     Int @default(1)
  extraFemaleCapacity   Int @default(1)

  // Appointments booked in this therapy slot
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([startTime])
  @@index([status])
  @@index([isActive])
  @@index([roomId])
}

// --------------------------------------------------------
// PATIENTS & APPOINTMENTS (THERAPY & CONSULTATION)
// --------------------------------------------------------

model Patient {
  id             String    @id @default(cuid())
  mrn            String?   @unique // Medical Record Number
  name           String
  phone          String
  gender         Gender
  age            Int?
  email          String?
  dateOfBirth    DateTime?
  address        String?
  emergencyPhone String?
  profession     String?
  bloodGroup     String?

  // Lifetime Billing Telemetry
  totalBill      Float     @default(0)
  totalPaid      Float     @default(0)
  totalDue       Float     @default(0)

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  treatmentPlans TreatmentPlan[]
  visits              PatientVisit[]
  consultationSerials ConsultationSerial[]
  stepLogs            PatientStepLog[]
  invoices            PatientInvoice[]
  payments            PatientPayment[]
  prescriptions       Prescription[]
  chatMessages        ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
  @@index([gender])
  @@index([email])
}

model Appointment {
  id String @id @default(cuid())

  // Appointment Type: THERAPY or CONSULTATION
  type AppointmentType @default(THERAPY)

  // Therapy Slot relation (used when type == THERAPY)
  therapySlotId String?
  therapySlot   TherapySlot? @relation(fields: [therapySlotId], references: [id], onDelete: SetNull)

  // Patient relation
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Visit and Invoice relations
  visitId   String?
  visit     PatientVisit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  invoiceId String?
  invoice   PatientInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)


  // Date of appointment (the calendar date for booking tickets)
  appointmentDate DateTime @default(now())

  // Gender quota consumed
  gender Gender

  // Regular or Extra
  bookingType BookingType @default(REGULAR)

  // Extra appointment approval tracking (if bookingType == EXTRA)
  extraStatus       ExtraApprovalStatus @default(NOT_APPLICABLE)
  extraReason       String?
  extraApprovedById String?
  extraApprovedBy   User?               @relation("AppointmentExtraApprover", fields: [extraApprovedById], references: [id], onDelete: SetNull)
  extraApprovedAt   DateTime?
  extraApprovalNote String?

  // Assigned Doctor (Independent User account under DOCTOR role)
  doctorId String?
  doctor   User? @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: SetNull)

  // Assigned Therapist / Handler / Staff conducting the therapy
  performerId String?
  performer   Performer? @relation("PerformerAppointments", fields: [performerId], references: [id], onDelete: SetNull)

  // Staff who booked (Performer under Receptionist/Admin/Doctor desk)
  bookedById String?
  bookedBy   Performer? @relation("AppointmentBooker", fields: [bookedById], references: [id], onDelete: SetNull)

  status AppointmentStatus @default(PENDING)
  notes  String?

  // Billing & Payment tracking
  feeAmount       Float?
  consultationFee Float?    @default(0)
  therapyFee      Float?    @default(0)
  paidAmount      Float?    @default(0)
  dueAmount       Float?    @default(0)
  paymentStatus   String?   @default("PENDING")
  paidAt          DateTime?
  paymentMethod   String?

  // Patient arrival / told time (e.g. "10:30 AM")
  toldTime String?

  // Check-in timestamp (marked on the ticket booked date)
  checkInTime DateTime?

  // Consultation lifecycle timestamps
  inConsultationTime  DateTime?
  outConsultationTime DateTime?

  // Therapy lifecycle timestamps
  inTherapyTime  DateTime?
  outTherapyTime DateTime?

  // Checkout timestamp (marked upon completing day visit)
  checkOutTime DateTime?

  // Expected / will call time (e.g. "11:30 AM")
  willCallTime String?

  // Routing origin tracking (e.g. "DOCTOR", "THERAPY")
  routingOrigin String?

  // Routing / Transfer Note & Timestamp
  routingNote String?
  routedAt    DateTime?

  // Queue assignment upon check-in: THERAPY or CONSULTATION
  queueId   String?
  queue     Queue?     @relation(fields: [queueId], references: [id], onDelete: SetNull)
  queueType QueueType? @default(THERAPY)

  // Real-time Station / Department Journey Location
  // Options: "RECEPTIONIST_DESK", "CONSULTATION_ROOM", "CASHIER_REGISTER", "THERAPY_ROOM", "CHECKED_OUT"
  currentStation String? @default("RECEPTIONIST_DESK")

  // Direct Room / Chamber assignment (e.g. Doctor consultation room or specific therapy room)
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  // Care Episode / Medical File relation
  medicalRecordId String?
  medicalFile     MedicalRecord? @relation("AppointmentMedicalFile", fields: [medicalRecordId], references: [id], onDelete: SetNull)

  // Consultation-specific schedule (when type == CONSULTATION)
  consultationDate DateTime?
  consultationTime String?

  medicalRecords MedicalRecord[]
  treatmentPlans TreatmentPlan[]
  prescriptions  Prescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([appointmentDate])
  @@index([appointmentDate, status])
  @@index([appointmentDate, queueType])
  @@index([appointmentDate, currentStation])
  @@index([currentStation])
  @@index([queueType])
  @@index([queueId])
  @@index([therapySlotId])
  @@index([patientId])
  @@index([medicalRecordId])
  @@index([gender])
  @@index([bookingType])
  @@index([status])
  @@index([extraStatus])
  @@index([doctorId])
  @@index([performerId])
  @@index([bookedById])
  @@index([roomId])
  @@index([visitId])
  @@index([invoiceId])
}

// --------------------------------------------------------
// QUEUE MODEL (THERAPY & CONSULTATION QUEUES)
// --------------------------------------------------------

model Queue {
  id          String    @id @default(cuid())
  name        String    // "Therapy Queue" or "Consultation Queue"
  type        QueueType @unique
  description String?
  isActive    Boolean   @default(true)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

// --------------------------------------------------------
// CLINICAL CONFIGURATION (DYNAMIC ISSUES & TREATMENTS)
// --------------------------------------------------------

model ClinicalOption {
  id          String                 @id @default(cuid())
  category    ClinicalOptionCategory
  name        String
  description String?
  order       Int                    @default(0)
  isActive    Boolean                @default(true)

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([order])
}

// --------------------------------------------------------
// MEDICAL RECORDS (PAIN PHYSIOTHERAPY ASSESSMENT & FILES)
// --------------------------------------------------------

model MedicalRecord {
  id             String   @id @default(cuid())

  // Patient relation
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Optional appointment link
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // Attending doctor (User)
  doctorId       String?
  doctor         User?        @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  // Metadata & Care Episode File tracking
  fileNumber     String?   // e.g. "FILE-2026-001"
  title          String?   // Episode Issue name e.g. "Back Pain & Knee Pain"
  status         String?   @default("ACTIVE") // ACTIVE, RESOLVED, CLOSED
  totalBill      Float     @default(0)
  totalPaid      Float     @default(0)
  totalDue       Float     @default(0)

  assessmentDate DateTime @default(now())
  age            Int?
  occupation     String?

  // Section 2: Pain Details
  painAreas      String   @default("[]") // JSON string array e.g. ["Neck", "Back"]
  painSide       String?  // "Right", "Left", "Both", "N/A"
  duration       String?  // e.g. "2 weeks", "6 months"
  painTypes      String   @default("[]") // JSON string array e.g. ["Sharp", "Dull", "Radiating"]

  // Section 3: Pain Scale & Triggers
  vasScore           Int?     @default(0) // Visual Analog Scale 0-10
  aggravatingFactors String   @default("[]") // JSON string array e.g. ["Movement", "Sitting", "Standing"]
  relievingFactors   String   @default("[]") // JSON string array e.g. ["Rest", "Medicine", "Heat"]

  // Section 4: History
  injuryAccident     Boolean? @default(false)
  injuryDetails      String?
  postureAdviceGiven Boolean? @default(false)
  surgeryHistory     Boolean? @default(false)
  surgeryDetails     String?
  previousTreatment  String?  // "Medicine", "Physiotherapy", "Both", "None"

  // Section 5: Functional Limitation
  functionalLimitations String @default("[]") // JSON string array e.g. ["Bending", "Sitting", "Walking"]

  // Section 6: Physical Examination
  rom                String?  // "Normal", "Restricted"
  muscleSpasm        Boolean? @default(false)
  tenderness         Boolean? @default(false)
  swelling           Boolean? @default(false)
  physicalExamNotes  String?

  // Section 7: Physiotherapy Diagnosis
  diagnosis          String?

  // Section 8: Treatment Plan (Dynamic Admin Modalities)
  treatmentPlans     String   @default("[]") // JSON string array e.g. ["Hot pack", "IFT / TENS", "Ultrasound"]
  treatmentNotes     String?

  // Section 9: Home Advice
  exerciseExplained  Boolean? @default(false)
  homePostureAdvice  Boolean? @default(false)

  // Follow-up & Progress
  followUpVasScore   Int?     // Pain scale after treatment (0-10)
  improvement        String?  // Doctor's improvement notes
  doctorSignature    String?  // Doctor / Therapist name or sign tag

  // All session appointments conducted under this care episode file
  fileAppointments   Appointment[] @relation("AppointmentMedicalFile")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([appointmentId])
  @@index([doctorId])
  @@index([assessmentDate])
  @@index([fileNumber])
  @@index([status])
}

// --------------------------------------------------------
// PATIENT TREATMENT PLANS (TODAY & NEXT SESSIONS)
// --------------------------------------------------------

enum TreatmentPlanType {
  TODAY
  NEXT
}

model TreatmentPlan {
  id            String            @id @default(cuid())
  planType      TreatmentPlanType @default(TODAY)

  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  doctorId      String?
  doctor        User?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  // Dynamic clinical treatment modalities (stored as JSON string array)
  modalities    String            @default("[]")

  // Instructions, protocol, duration, frequency, home guidelines
  instructions  String?

  // Target date for this treatment plan (e.g. today or next scheduled visit)
  targetDate    DateTime?

  isActive      Boolean           @default(true)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([patientId])
  @@index([appointmentId])
  @@index([doctorId])
  @@index([planType])
  @@index([createdAt])
}

// --------------------------------------------------------
// PATIENT VISIT LIFECYCLE & WORKFLOW ENGINE
// --------------------------------------------------------

model PatientVisit {
  id                  String               @id @default(cuid())
  patientId           String
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitNumber         Int                  @default(1)
  visitDate           DateTime             @default(now())
  checkInTime         DateTime             @default(now())
  checkOutTime        DateTime?
  status              String               @default("CHECKED_IN") // CHECKED_IN, IN_PROGRESS, CHECKED_OUT
  checkInPerformerId  String?
  checkOutPerformerId String?
  notes               String?

  consultationSerials ConsultationSerial[]
  stepLogs            PatientStepLog[]
  invoices            PatientInvoice[]
  payments            PatientPayment[]
  appointments        Appointment[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([patientId, visitDate])
  @@index([status])
}

model ConsultationSerial {
  id                  String          @id @default(cuid())
  serialNumber        Int
  appointmentDate     DateTime        @default(now())
  doctorId            String
  doctor              User            @relation("DoctorConsultationSerials", fields: [doctorId], references: [id])
  patientId           String
  patient             Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId             String?
  visit               PatientVisit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)

  toldTime            String?
  feeAmount           Float           @default(0)
  paidAmount          Float           @default(0)
  dueAmount           Float           @default(0)
  paymentStatus       String          @default("PENDING") // PENDING, PAID, DUE, PARTIAL

  status              String          @default("FORWARDED_TO_CASHIER") // FORWARDED_TO_CASHIER, QUEUED, CALLING, IN_CONSULTATION, COMPLETED, CANCELLED
  inConsultationTime  DateTime?
  outConsultationTime DateTime?

  bookedById          String?
  cashierPerformerId  String?
  invoiceId           String?
  invoice             PatientInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  notes               String?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([doctorId, appointmentDate, serialNumber])
  @@index([patientId])
  @@index([status])
  @@index([visitId])
  @@index([invoiceId])
}

model PatientStepLog {
  id          String        @id @default(cuid())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId     String?
  visit       PatientVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  step        String        // CHECK_IN, FORWARDED_TO_CASHIER, BILL_COLLECTED, BILL_MARKED_DUE, INVOICE_PRINTED, QUEUED_FOR_DOCTOR, CONSULTATION_START, CONSULTATION_END, QUEUED_FOR_THERAPY, THERAPY_START, THERAPY_END, CHECK_OUT
  station     String        // RECEPTIONIST_DESK, CASHIER_REGISTER, CONSULTATION_ROOM, THERAPY_ROOM, CHECKED_OUT
  roomNumber  String?
  doctorId    String?
  performerId String?
  details     String?
  timestamp   DateTime      @default(now())

  createdAt   DateTime      @default(now())

  @@index([patientId, timestamp])
  @@index([visitId])
}

model PatientInvoice {
  id                  String               @id @default(cuid())
  invoiceNumber       String               @unique
  patientId           String
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId             String?
  visit               PatientVisit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)

  totalAmount         Float                @default(0)
  paidAmount          Float                @default(0)
  dueAmount           Float                @default(0)
  status              String               @default("PAID") // PAID, DUE, PARTIAL
  paymentMethod       String               @default("CASH") // CASH, CARD, MFS, DUE

  cashierPerformerId  String?
  notes               String?

  consultationSerials ConsultationSerial[]
  payments            PatientPayment[]
  appointments        Appointment[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([patientId])
  @@index([invoiceNumber])
  @@index([visitId])
}

model PatientPayment {
  id                  String          @id @default(cuid())
  patientId           String
  patient             Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId             String?
  visit               PatientVisit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  invoiceId           String?
  invoice             PatientInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  serviceType         String          // "CONSULTATION", "THERAPY", "COMBINED"
  amount              Float
  paymentMethod       String          // "CASH", "CARD", "MFS", "DUE"
  isDue               Boolean         @default(false)
  cashierPerformerId  String?
  notes               String?

  createdAt           DateTime        @default(now())

  @@index([patientId])
  @@index([invoiceId])
  @@index([visitId])
}

// --------------------------------------------------------
// CLINIC REAL-TIME INTERNAL CHAT & MESSAGING SYSTEM
// Partitioned daily by calendar date (dateStr / messageDate)
// --------------------------------------------------------

model ChatMessage {
  id             String    @id @default(cuid())
  dateStr        String    // e.g. "2026-10-09" (Daily partitioned calendar date)
  messageDate    DateTime  @default(now())
  channel        String    @default("GENERAL") // "GENERAL", "CLINICAL", "RECEPTION", "THERAPY", "CASHIER", or "DM:userId1:userId2"
  content        String    // Text only
  isUrgent       Boolean   @default(false)

  // Sender details
  senderId       String
  sender         User      @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderRole     Role
  senderName     String
  performerId    String?
  performer      Performer? @relation("PerformerChatMessages", fields: [performerId], references: [id], onDelete: SetNull)
  performerName  String?

  // Optional recipient (for 1-on-1 direct staff messages)
  recipientId    String?
  recipient      User?     @relation("ReceivedChatMessages", fields: [recipientId], references: [id], onDelete: SetNull)
  recipientName  String?

  // Optional clinical / patient reference
  patientId      String?
  patient        Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName    String?
  roomNumber     String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([dateStr, channel])
  @@index([dateStr, createdAt])
  @@index([senderId])
  @@index([recipientId])
  @@index([patientId])
}

// --------------------------------------------------------
// CLINICAL PRESCRIPTIONS (DOCTOR TO PATIENT)
// --------------------------------------------------------

model Prescription {
  id             String       @id @default(cuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctor         User?        @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: SetNull)
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  diagnosis      String?
  medicines      String       @default("[]") // JSON string: [{ name, mealTiming: "BEFORE"|"AFTER", times: ["MORNING", "AFTERNOON", "NIGHT"], duration: "5 days", instructions: "" }]
  advice         String?
  followUpDate   DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentId])
  @@index([createdAt])
}

// --------------------------------------------------------
// PER-BED THERAPY SESSION TIMERS
// --------------------------------------------------------

model TherapySessionTimer {
  id               String    @id @default(cuid())
  appointmentId    String?   @unique
  patientId        String
  roomNumber       String?   // e.g. "208"
  modalities       String    // JSON string: [{ id, name, durationMinutes, totalSeconds, remainingSeconds, isRunning, isCompleted, isSkipped, order }]
  currentStepIndex Int       @default(0)
  isRunning        Boolean   @default(false)
  lastStartedAt    DateTime?
  performerId      String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([appointmentId])
  @@index([patientId])
  @@index([roomNumber])
}
